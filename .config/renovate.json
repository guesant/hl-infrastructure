{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Sao_Paulo",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Rolling base image tags are rebuilt weekly, so their release age never reaches 7 days",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "python", "alpine"],
      "minimumReleaseAge": null
    },
    {
      "description": "The Helm image version always comes from helm_version in group_vars via --build-arg",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine/helm"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["k3s_version:\\s*(?<currentValue>v[\\w.+-]+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["helm_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["cilium_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "cilium/cilium",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["cilium_cli_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "cilium/cilium-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["cert_manager_chart_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "cert-manager",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://charts.jetstack.io"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["argocd_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "argo-cd",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["argocd_image_updater_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "argocd-image-updater",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["cnpg_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "cloudnative-pg",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://cloudnative-pg.github.io/charts"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["sealed_secrets_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "sealed-secrets",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://bitnami.github.io/sealed-secrets"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible/group_vars/all/versions\\.yml$/"],
      "matchStrings": ["cnpg_barman_plugin_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "plugin-barman-cloud",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://cloudnative-pg.github.io/charts"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.tools/docker/Dockerfile$/"],
      "matchStrings": ["@ast-grep/cli@(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "@ast-grep/cli",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.tools/docker/Dockerfile$/"],
      "matchStrings": ["jscpd@(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "jscpd",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.tools/docker/Dockerfile$/"],
      "matchStrings": ["(?<!\\S)cspell@(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "cspell",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.tools/docker/Dockerfile$/"],
      "matchStrings": ["@cspell/dict-pt-br@(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "@cspell/dict-pt-br",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.tools/docker/Dockerfile$/"],
      "matchStrings": ["yamllint==(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "yamllint",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.tools/docker/Dockerfile$/"],
      "matchStrings": ["ansible-lint==(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "ansible-lint",
      "datasourceTemplate": "pypi"
    }
  ]
}
