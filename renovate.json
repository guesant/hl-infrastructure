{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Sao_Paulo",
  "kubernetes": {
    "fileMatch": ["ansible/roles/.+/files/.+\\.ya?ml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["k3s_version:\\s*(?<currentValue>v[\\w.+-]+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["helm_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["cilium_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "cilium/cilium",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["cilium_cli_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "cilium/cilium-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["argocd_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["argocd_image_updater_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "argoproj-labs/argocd-image-updater",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["ansible/roles/cert-manager/files/cert-manager-install.yaml"],
      "groupName": "cert-manager",
      "postUpgradeTasks": {
        "commands": [
          "curl -fsSL https://github.com/cert-manager/cert-manager/releases/download/{{{newVersion}}}/cert-manager.yaml -o ansible/roles/cert-manager/files/cert-manager-install.yaml"
        ],
        "fileFilters": ["ansible/roles/cert-manager/files/cert-manager-install.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchFileNames": ["ansible/roles/sealed-secrets/files/sealed-secrets-install.yaml"],
      "groupName": "sealed-secrets",
      "postUpgradeTasks": {
        "commands": [
          "curl -fsSL https://github.com/bitnami-labs/sealed-secrets/releases/download/v{{{newVersion}}}/controller.yaml -o ansible/roles/sealed-secrets/files/sealed-secrets-install.yaml"
        ],
        "fileFilters": ["ansible/roles/sealed-secrets/files/sealed-secrets-install.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchFileNames": ["ansible/roles/argocd/files/argocd-install.yaml"],
      "groupName": "argocd",
      "postUpgradeTasks": {
        "commands": [
          "curl -fsSL https://raw.githubusercontent.com/argoproj/argo-cd/{{{newVersion}}}/manifests/install.yaml -o ansible/roles/argocd/files/argocd-install.yaml"
        ],
        "fileFilters": ["ansible/roles/argocd/files/argocd-install.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchFileNames": ["ansible/roles/argocd-image-updater/files/argocd-image-updater-install.yaml"],
      "groupName": "argocd-image-updater",
      "postUpgradeTasks": {
        "commands": [
          "curl -fsSL https://raw.githubusercontent.com/argoproj-labs/argocd-image-updater/{{{newVersion}}}/manifests/install.yaml -o ansible/roles/argocd-image-updater/files/argocd-image-updater-install.yaml"
        ],
        "fileFilters": ["ansible/roles/argocd-image-updater/files/argocd-image-updater-install.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchFileNames": ["ansible/roles/cnpg-barman-plugin/files/cnpg-barman-plugin-install.yaml"],
      "groupName": "cnpg-barman-plugin",
      "postUpgradeTasks": {
        "commands": [
          "curl -fsSL https://github.com/cloudnative-pg/plugin-barman-cloud/releases/download/{{{newVersion}}}/manifest.yaml -o ansible/roles/cnpg-barman-plugin/files/cnpg-barman-plugin-install.yaml"
        ],
        "fileFilters": ["ansible/roles/cnpg-barman-plugin/files/cnpg-barman-plugin-install.yaml"],
        "executionMode": "update"
      }
    },
    {
      "matchFileNames": ["ansible/roles/cnpg/files/cnpg-install.yaml"],
      "groupName": "cnpg (baixa confianca na URL, confirmar antes de confiar no postUpgradeTask)",
      "postUpgradeTasks": {
        "commands": [
          "curl -fsSL https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/main/releases/cnpg-{{{newVersion}}}.yaml -o ansible/roles/cnpg/files/cnpg-install.yaml"
        ],
        "fileFilters": ["ansible/roles/cnpg/files/cnpg-install.yaml"],
        "executionMode": "update"
      }
    }
  ]
}
