{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Sao_Paulo",
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["k3s_version:\\s*(?<currentValue>v[\\w.+-]+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["helm_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["cilium_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "cilium/cilium",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["cilium_cli_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "cilium/cilium-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["cert_manager_chart_version:\\s*(?<currentValue>v[\\w.-]+)"],
      "depNameTemplate": "cert-manager",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://charts.jetstack.io"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["argocd_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "argo-cd",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["argocd_image_updater_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "argocd-image-updater",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["cnpg_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "cloudnative-pg",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://cloudnative-pg.github.io/charts"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["sealed_secrets_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "sealed-secrets",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://bitnami.github.io/sealed-secrets"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ansible/group_vars/all\\.example\\.yml$"],
      "matchStrings": ["cnpg_barman_plugin_chart_version:\\s*(?<currentValue>[\\w.-]+)"],
      "depNameTemplate": "plugin-barman-cloud",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://cloudnative-pg.github.io/charts"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/security\\.yml$"],
      "matchStrings": ["zricethezav/gitleaks:(?<currentValue>v[\\w.]+)"],
      "depNameTemplate": "zricethezav/gitleaks",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/security\\.yml$"],
      "matchStrings": ["ghcr\\.io/google/osv-scanner:(?<currentValue>v[\\w.]+)"],
      "depNameTemplate": "ghcr.io/google/osv-scanner",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/(security|infra-lint)\\.yml$"],
      "matchStrings": ["aquasec/trivy:(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "aquasec/trivy",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/infra-lint\\.yml$"],
      "matchStrings": ["stackrox/kube-linter:(?<currentValue>v[\\w.]+)"],
      "depNameTemplate": "stackrox/kube-linter",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/infra-lint\\.yml$"],
      "matchStrings": ["bridgecrew/checkov:(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "bridgecrew/checkov",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/quality\\.yml$"],
      "matchStrings": ["node:(?<currentValue>[\\w.-]+)-slim"],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/quality\\.yml$"],
      "matchStrings": ["@ast-grep/cli@(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "@ast-grep/cli",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/quality\\.yml$"],
      "matchStrings": ["jscpd@(?<currentValue>[\\w.]+)"],
      "depNameTemplate": "jscpd",
      "datasourceTemplate": "npm"
    }
  ]
}
