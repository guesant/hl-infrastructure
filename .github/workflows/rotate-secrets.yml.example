name: rotate-secrets

on:
  schedule:
    - cron: "0 5 1 * *"
  workflow_dispatch:
    inputs:
      target:
        description: what to rotate
        type: choice
        default: sops-data-keys
        options:
          - sops-data-keys
          - cloudflare-tunnel-token
          - cloudflare-api-token
          - all

permissions:
  contents: read

env:
  SOPS_VERSION: v3.13.3
  SOPS_SHA256_AMD64: e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b

jobs:
  sops-data-keys:
    if: github.event_name == 'schedule' || inputs.target == 'sops-data-keys' || inputs.target == 'all'
    runs-on: ubuntu-24.04
    environment: rotation-sops
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install sops
        run: |
          curl -fsSLo sops "https://github.com/getsops/sops/releases/download/${SOPS_VERSION}/sops-${SOPS_VERSION}.linux.amd64"
          echo "${SOPS_SHA256_AMD64}  sops" | sha256sum -c -
          install -m 0755 sops /usr/local/bin/sops

      - name: Rotate the data key of every encrypted file
        env:
          SOPS_AGE_KEY: ${{ secrets.ROTATION_AGE_KEY }}
        run: |
          set -euo pipefail
          while IFS= read -r file; do
            sops rotate -i "$file"
            echo "rotated $file"
          done < <(git ls-files '*.sops-secret.yaml' 'tofu/**/*.sops.env' 'ansible/group_vars/**/*.sops.yaml')

      - name: Open the pull request
        env:
          GH_TOKEN: ${{ secrets.ROTATION_PR_TOKEN }}
        run: |
          set -euo pipefail
          branch="chore/sops-rotate-$(date -u +%Y%m%d)"
          git config user.name "hl-infrastructure rotation"
          git config user.email "rotation@users.noreply.github.com"
          git checkout -b "$branch"
          git add -A
          git commit -m "chore(sops): rotate the data keys"
          git push "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" "$branch"
          gh pr create --fill --base main --head "$branch"

  cloudflare-tunnel-token:
    if: inputs.target == 'cloudflare-tunnel-token' || inputs.target == 'all'
    runs-on: ubuntu-24.04
    environment: rotation-cloudflare
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Rotate the tunnel secret and re-encrypt the token
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_TUNNEL_TOKEN }}
          ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          TUNNEL_ID: ${{ secrets.CLOUDFLARE_TUNNEL_ID }}
          SOPS_AGE_KEY: ${{ secrets.ROTATION_AGE_KEY }}
        run: |
          set -euo pipefail
          secret="$(head -c 32 /dev/urandom | base64 -w0)"
          curl -fsS -X PATCH "https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/cfd_tunnel/${TUNNEL_ID}" \
            -H "Authorization: Bearer ${CLOUDFLARE_API_TOKEN}" -H "Content-Type: application/json" \
            --data "{\"tunnel_secret\":\"${secret}\"}" >/dev/null
          token="$(curl -fsS "https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/cfd_tunnel/${TUNNEL_ID}/token" \
            -H "Authorization: Bearer ${CLOUDFLARE_API_TOKEN}" | jq -r .result)"
          printf '%s' "$token" | sops set --value-stdin \
            argocd/apps/satellites/blog/cloudflared/templates/tunnel-token.sops-secret.yaml \
            '["spec"]["secretTemplates"][0]["stringData"]["token"]'

      - name: Open the pull request
        env:
          GH_TOKEN: ${{ secrets.ROTATION_PR_TOKEN }}
        run: |
          set -euo pipefail
          branch="chore/cloudflare-tunnel-token-$(date -u +%Y%m%d)"
          git config user.name "hl-infrastructure rotation"
          git config user.email "rotation@users.noreply.github.com"
          git checkout -b "$branch"
          git add -A
          git commit -m "chore(cloudflared): rotate the tunnel token"
          git push "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" "$branch"
          gh pr create --fill --base main --head "$branch"

  cloudflare-api-token:
    if: inputs.target == 'cloudflare-api-token' || inputs.target == 'all'
    runs-on: ubuntu-24.04
    environment: rotation-cloudflare-admin
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Roll the OpenTofu API token and re-encrypt it
        env:
          CLOUDFLARE_ADMIN_TOKEN: ${{ secrets.CLOUDFLARE_TOKENS_EDIT_TOKEN }}
          TOFU_TOKEN_ID: ${{ secrets.CLOUDFLARE_TOFU_TOKEN_ID }}
          SOPS_AGE_KEY: ${{ secrets.ROTATION_AGE_KEY }}
        run: |
          set -euo pipefail
          value="$(curl -fsS -X PUT "https://api.cloudflare.com/client/v4/user/tokens/${TOFU_TOKEN_ID}/value" \
            -H "Authorization: Bearer ${CLOUDFLARE_ADMIN_TOKEN}" -H "Content-Type: application/json" --data '{}' | jq -r .result)"
          printf '%s' "$value" | sops set --value-stdin tofu/cloudflare/cloudflare.sops.env '["CLOUDFLARE_API_TOKEN"]'

      - name: Open the pull request
        env:
          GH_TOKEN: ${{ secrets.ROTATION_PR_TOKEN }}
        run: |
          set -euo pipefail
          branch="chore/cloudflare-api-token-$(date -u +%Y%m%d)"
          git config user.name "hl-infrastructure rotation"
          git config user.email "rotation@users.noreply.github.com"
          git checkout -b "$branch"
          git add -A
          git commit -m "chore(tofu): rotate the cloudflare api token"
          git push "https://x-access-token:${GH_TOKEN}@github.com/${GITHUB_REPOSITORY}.git" "$branch"
          gh pr create --fill --base main --head "$branch"
