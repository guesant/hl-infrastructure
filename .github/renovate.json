{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Sao_Paulo",
  "minimumReleaseAge": "7 days",
  "platformCommit": "enabled",
  "pip-compile": {
    "managerFilePatterns": [
      "/^docs/requirements\\.txt$/",
      "/^\\.tools/docker/pip/.*\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "postUpgradeTasks": [
    {
      "commands": [
        "bash .tools/renovate-version-checksums.sh"
      ],
      "fileFilters": [
        "ansible/group_vars/all/versions.yml"
      ],
      "executionMode": "branch"
    }
  ],
  "packageRules": [
    {
      "description": "Keep every Dockerfile base image pinned by digest next to its tag",
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true
    },
    {
      "description": "Chart values that pin an image as tag@digest keep the digest in step with the tag",
      "matchManagers": [
        "helm-values"
      ],
      "pinDigests": true
    },
    {
      "description": "Rolling base image tags are rebuilt weekly, so their release age never reaches 7 days",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node",
        "python",
        "alpine"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "required_version constrains OpenTofu, not Terraform, so it must not be bumped against Terraform releases",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "enabled": false
    },
    {
      "description": "The Helm image and the Helm binary the node downloads move together",
      "groupName": "helm",
      "matchPackageNames": [
        "alpine/helm",
        "helm/helm"
      ]
    },
    {
      "description": "Vendored Kubernetes manifests (local-path provisioner, keycloak operator) keep tag and digest together",
      "matchManagers": [
        "kubernetes"
      ],
      "pinDigests": true
    },
    {
      "description": "The blog image tag in the chart values is written by Kargo, not by Renovate",
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "ghcr.io/guesant/blog"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s*(?<currentValue>v[\\w.+-]+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "helm_version:\\s*(?<currentValue>v[\\w.-]+)"
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "cilium_version:\\s*(?<currentValue>[\\w.-]+)"
      ],
      "depNameTemplate": "cilium/cilium",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "cilium_cli_version:\\s*(?<currentValue>v[\\w.-]+)"
      ],
      "depNameTemplate": "cilium/cilium-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "argocd_chart_version:\\s*(?<currentValue>[\\w.-]+)"
      ],
      "depNameTemplate": "argo-cd",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^justfile$/"
      ],
      "matchStrings": [
        "tofu_image := \"ghcr.io/opentofu/opentofu:(?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "depNameTemplate": "ghcr.io/opentofu/opentofu",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "rhysd/actionlint:(?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.tools/docker/Dockerfile$/"
      ],
      "matchStrings": [
        "AGE_PLUGIN_SE_VERSION=(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "remko/age-plugin-se",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^argocd/apps/.+/templates/.+\\.yaml$/"
    ]
  }
}
