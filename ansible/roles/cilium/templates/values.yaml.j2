kubeProxyReplacement: true
k8sServiceHost: {{ ansible_host }}
k8sServicePort: "6443"
routingMode: tunnel
tunnelProtocol: vxlan
devices: wlan0
l7Proxy: false
ipam:
  operator:
    clusterPoolIPv4PodCIDRList:
      - 10.42.0.0/16
operator:
  replicas: 1
envoy:
  enabled: false
policyEnforcementMode: always
policyAuditMode: true
hubble:
  enabled: true
  relay:
    enabled: true
