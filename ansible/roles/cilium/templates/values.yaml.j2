kubeProxyReplacement: true
k8sServiceHost: {{ ansible_host }}
k8sServicePort: "6443"
routingMode: tunnel
tunnelProtocol: vxlan
devices: wlan0
l7Proxy: false
ipam:
  operator:
    clusterPoolIPv4PodCIDRList:
      - 10.42.0.0/16
operator:
  replicas: 1
  resources:
    requests:
      cpu: 20m
      memory: 64Mi
    limits:
      memory: 128Mi
envoy:
  enabled: false
policyEnforcementMode: always
policyAuditMode: true
hubble:
  enabled: true
  relay:
    enabled: true
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 64Mi
resources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    memory: 512Mi
